PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinema_db

# Tự đặt 1 chuỗi dài, ngẫu nhiên trong file .env (không commit)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Trang chọn ghế
HOLD_MINUTES=7
MAX_SEATS_PER_ORDER=8
SALES_CUTOFF_MINUTES=15
DISCONNECT_GRACE_SECONDS=30
SWEEP_INTERVAL_SECONDS=5
